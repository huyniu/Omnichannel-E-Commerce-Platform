# Copy to .env and change every secret before deploying.

# ---- Images (production compose) ----
REGISTRY=ghcr.io/your-github-user
IMAGE_TAG=latest

# ---- Public URL of the API (used for payment callbacks) ----
PUBLIC_BASE_URL=https://api.example.com

# ---- Secrets ----
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
POSTGRES_PASSWORD=postgres
IDENTITY_DB_PASSWORD=identity
ORDER_DB_PASSWORD=order_svc
PAYMENT_DB_PASSWORD=payment_svc
ADMIN_EMAIL=admin@omni.local
ADMIN_PASSWORD=Admin@123
MOCK_GATEWAY_SECRET=mock-gateway-secret
GRAFANA_ADMIN_PASSWORD=admin

# ---- Payment ----
# Keep the mock gateway for demos/load tests; set false once VNPay is configured.
MOCK_GATEWAY_ENABLED=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://api.example.com/api/payments/vnpay/return

# ---- E-mail (dev uses Mailpit, production a real SMTP relay) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@omni.local

# ---- Tuning ----
RATE_LIMIT_REPLENISH=50
RATE_LIMIT_BURST=100
ORDER_PAYMENT_TIMEOUT=15m
TRACING_SAMPLING=0.0

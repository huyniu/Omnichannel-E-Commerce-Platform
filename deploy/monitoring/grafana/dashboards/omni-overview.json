{
  "uid": "omni-overview",
  "title": "Omnichannel - Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["omni"],
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "HTTP requests / s by service",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{service}}",
        "expr": "sum by (service) (rate(http_server_requests_seconds_count[1m]))" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "p95 latency by service (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{service}}",
        "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_server_requests_seconds_bucket[1m])))" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "HTTP 5xx / s",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{service}}",
        "expr": "sum by (service) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Orders created vs rejected (per s)",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "created", "expr": "sum(rate(orders_created_total[1m]))" },
        { "refId": "B", "legendFormat": "out of stock", "expr": "sum(rate(orders_rejected_total[1m]))" },
        { "refId": "C", "legendFormat": "lock timeout (429)", "expr": "sum(rate(inventory_lock_timeouts_total[1m]))" }
      ]
    },
    {
      "id": 5, "type": "stat", "title": "Outbox events waiting for Kafka",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{service}}", "expr": "outbox_pending" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "JVM heap used (MB)",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{service}}",
        "expr": "sum by (service) (jvm_memory_used_bytes{area=\"heap\"}) / 1024 / 1024" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Process CPU usage",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{service}}", "expr": "process_cpu_usage" }]
    },
    {
      "id": 8, "type": "logs", "title": "Error logs (all services)",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{service=~\".+\"} |~ \"ERROR|WARN\"" }]
    }
  ]
}
